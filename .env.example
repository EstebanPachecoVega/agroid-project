# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio ni pegues las claves en el chat.
#
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Router gratuito (modelos aleatorios) o un modelo fijo con soporte de tools.
LLM_MODEL=openrouter/free
LLM_MODEL_PINNED=nvidia/nemotron-3.5-lightning:free
LLM_EMBED_MODEL=openai/text-embedding-3-small

# LangSmith: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agroid-huevos-ep3
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Límites de seguridad y cuota
AGROID_MAX_ITERATIONS=8
AGROID_MAX_INPUT_CHARS=2000
AGROID_MAX_OUTPUT_TOKENS=800
AGROID_MAX_TOOL_WRITES=3
AGROID_RATE_LIMIT_PER_MINUTE=15
AGROID_RATE_LIMIT_TURNS_PER_DAY=45
AGROID_MAX_CONCURRENT=3

# Modelo de referencia para el "costo equivalente" (no se usa para inferencia).
AGROID_REFERENCE_MODEL=google/gemini-2.5-flash-lite
AGROID_REFERENCE_INPUT_PER_MTOK=0.10
AGROID_REFERENCE_OUTPUT_PER_MTOK=0.40

# Opcional: firma HMAC del manifiesto del manual (recomendado en producción).
AGROID_MANIFEST_HMAC_KEY=
